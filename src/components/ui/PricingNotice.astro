---
import { settings } from '../../lib/site';
interface Props { class?: string }
const { class: cls } = Astro.props;
---
{settings.showPricingNotice && (
  <p class:list={['inline-flex items-center gap-2 text-sm font-semibold text-muted', cls]}>
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.5v4.2M8 10.6v.9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    {settings.pricingNotice}
  </p>
)}
