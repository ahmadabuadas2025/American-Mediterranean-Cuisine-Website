---
import type { Package } from '../../lib/schemas';
import PriceLabel from './PriceLabel.astro';
import DietaryBadges from './DietaryBadges.astro';

interface Props { id: string; pkg: Package; href?: string; cta?: string; index?: number; headingLevel?: 'h2' | 'h3' }
const { id, pkg, href, cta, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const link = href ?? `/order/?package=${id}`;
const label = cta ?? (pkg.kind === 'event-tier' ? 'Plan this event' : pkg.custom ? 'Start a custom order' : 'Build this order');
---
<article class="group card lift flex h-full flex-col overflow-hidden" data-reveal>
  <div class="media-mask aspect-[4/3] !rounded-none">
    {pkg.image && <img src={pkg.image} alt={pkg.imageAlt ?? ''} width="1200" height="900" loading="lazy" decoding="async" />}
  </div>
  <div class="flex flex-1 flex-col gap-4 p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <Heading class="h-sm">{pkg.name}</Heading>
        {pkg.serves && pkg.serves !== '1' && <p class="mt-1 text-sm font-semibold text-muted">Serves {pkg.serves}</p>}
        {pkg.minGuests && <p class="mt-1 text-sm font-semibold text-muted">From {pkg.minGuests} guests</p>}
      </div>
      <PriceLabel price={pkg.price} unit={pkg.priceUnit} class="shrink-0" />
    </div>
    <p class="text-muted">{pkg.summary}</p>
    {pkg.inclusions.length > 0 && (
      <ul class="space-y-1 text-[0.95rem]">
        {pkg.inclusions.map((i) => (
          <li class="flex gap-2"><span aria-hidden="true" class="text-olive-mid">—</span>{i}</li>
        ))}
      </ul>
    )}
    <DietaryBadges tags={pkg.dietary} />
    <a href={link} class="link-arrow mt-auto" data-track="offer_selected" data-track-package={id}>
      <span class="label">{label}</span><span class="sr-only">: {pkg.name}</span><span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</article>
