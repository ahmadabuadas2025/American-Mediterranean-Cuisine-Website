---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image?: string;
  imageAlt?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const { eyebrow, title, lede, image, imageAlt = '', primary, secondary } = Astro.props;
---
<section class="container-x pt-10 pb-16 md:pt-16 md:pb-24">
  <div class="grid items-end gap-10 lg:grid-cols-12">
    <div class:list={[image ? 'lg:col-span-7' : 'lg:col-span-10']}>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h-xl mt-5" data-reveal-words set:html={title} />
      <p class="lede mt-6" data-reveal>{lede}</p>
      {(primary || secondary) && (
        <div class="mt-8 flex flex-wrap gap-3" data-reveal>
          {primary && <a href={primary.href} class="btn btn-primary" data-track="builder_cta" data-track-location="page_hero">{primary.label}</a>}
          {secondary && <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>}
        </div>
      )}
    </div>
    {image && (
      <div class="media-mask aspect-[4/5] lg:col-span-5" data-reveal>
        <img src={image} alt={imageAlt} width="1200" height="1500" fetchpriority="high" decoding="async" data-parallax="0.12" class="scale-110" />
      </div>
    )}
  </div>
</section>
