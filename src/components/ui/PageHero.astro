---
import Img from './Img.astro';
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image?: string;
  imageAlt?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const { eyebrow, title, lede, image, imageAlt = '', primary, secondary } = Astro.props;
---
<section class="container-x pt-10 pb-16 md:pt-16 md:pb-24">
  <div class="grid items-end gap-10 lg:grid-cols-12">
    <div class:list={[image ? 'lg:col-span-7' : 'lg:col-span-10']}>
      <p class="eyebrow enter">{eyebrow}</p>
      <h1 class="enter enter-2 h-xl mt-5" set:html={title} />
      <p class="enter enter-3 lede mt-6">{lede}</p>
      {(primary || secondary) && (
        <div class="enter enter-3 mt-8 flex flex-wrap gap-3">
          {primary && <a href={primary.href} class="btn btn-primary" data-track="builder_cta" data-track-location="page_hero">{primary.label}</a>}
          {secondary && <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>}
        </div>
      )}
    </div>
    {image && (
      <div class="media-mask aspect-[4/5] lg:col-span-5">
        <Img src={image} alt={imageAlt} width={1200} height={1500} loading="eager" fetchpriority="high" sizes="(min-width: 1024px) 40vw, 100vw" data-parallax="0.12" class="scale-110" />
      </div>
    )}
  </div>
</section>
