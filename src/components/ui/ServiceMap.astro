---
/**
 * Service-area map. Nothing loads from a third party until the visitor asks,
 * and no API key is needed (OpenStreetMap embed).
 */
import { settings, zones } from '../../lib/site';
const { lat, lng, zoom } = settings.map;
const span = 0.9 / Math.max(1, zoom - 8);
const bbox = [lng - span, lat - span * 0.6, lng + span, lat + span * 0.6].map((n) => n.toFixed(4)).join(',');
const src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lng}`;
const confirmedZones = zones.zones.filter((z) => z.zips.length > 0 && !z.name.startsWith('TODO'));
---
<div class="card overflow-hidden">
  <div class="relative aspect-[4/3] bg-olive-soft" data-map>
    <svg class="absolute inset-0 size-full" viewBox="0 0 400 300" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <rect width="400" height="300" fill="var(--brand-olive-soft)" />
      <path d="M0 210 C 60 190 90 230 140 205 S 210 150 250 175 S 330 240 400 200 V300 H0Z" fill="var(--brand-sand-soft)" />
      <path d="M150 120 C 175 150 160 190 190 215" stroke="var(--brand-paper)" stroke-width="16" fill="none" stroke-linecap="round" />
      <circle cx="205" cy="140" r="72" fill="none" stroke="var(--brand-olive-mid)" stroke-width="1.5" stroke-dasharray="4 6" />
      <circle cx="205" cy="140" r="7" fill="var(--brand-terracotta)" />
    </svg>
    <div class="absolute inset-x-4 bottom-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-paper/95 p-4">
      <p class="font-semibold">{settings.serviceAreaLabel}</p>
      <button type="button" class="btn btn-ghost min-h-11 px-4 text-sm" data-map-load>Show interactive map</button>
    </div>
    <template data-map-template>
      <iframe title={`Map of ${settings.serviceAreaLabel}`} src={src} loading="lazy" class="absolute inset-0 size-full border-0" referrerpolicy="no-referrer"></iframe>
    </template>
  </div>
  <div class="p-6">
    <p class="text-muted">{settings.serviceAreaDetail}</p>
    {confirmedZones.length > 0 && (
      <ul class="mt-4 space-y-2">
        {confirmedZones.map((z) => <li><strong>{z.name}</strong>{z.description && ` — ${z.description}`}</li>)}
      </ul>
    )}
    <p class="mt-3 text-sm text-muted">{zones.outOfZoneNote}</p>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
      map.querySelector('[data-map-load]')?.addEventListener('click', (e) => {
        const tpl = map.querySelector<HTMLTemplateElement>('[data-map-template]');
        if (!tpl) return;
        map.appendChild(tpl.content.cloneNode(true));
        (e.currentTarget as HTMLElement).closest('div')?.remove();
      });
    });
  });
</script>
