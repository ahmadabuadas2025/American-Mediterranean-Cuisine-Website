---
---
<a href="/" class="logo inline-flex min-h-11 items-center gap-2.5 text-olive no-underline">
  <svg class="logo-mark size-9 shrink-0" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="19" fill="currentColor" />
    <path d="M12 27c5-1 10-5 15-14" stroke="var(--brand-ivory)" stroke-width="1.6" fill="none" stroke-linecap="round" />
    <ellipse cx="17.5" cy="20.5" rx="2.2" ry="4.6" transform="rotate(-38 17.5 20.5)" fill="var(--brand-ivory)" />
    <ellipse cx="23.6" cy="16.6" rx="2" ry="4.2" transform="rotate(52 23.6 16.6)" fill="var(--brand-ivory)" opacity=".75" />
    <circle cx="27.4" cy="12.4" r="2.1" fill="var(--brand-terracotta)" />
  </svg>
  <span class="logo-text font-display text-[0.98rem] leading-[1.02] tracking-[-0.01em] sm:text-[1.08rem]">
    <span class="block">American</span>
    <span class="block font-[360] italic"><span class="logo-word">Mediterranean</span> <span class="logo-word">Cuisine</span></span>
  </span>
</a>
<style>
  /* Small phones: stack the name in three short lines so it fits beside the order button */
  @media (max-width: 419px) {
    .logo-text { font-size: 0.8rem; line-height: 0.98; }
    .logo-word { display: block; }
    .logo-mark { width: 2rem; height: 2rem; }
  }
</style>
