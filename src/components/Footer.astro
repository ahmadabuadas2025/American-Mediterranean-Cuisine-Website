---
import { primaryNav, secondaryNav } from '../lib/nav';
import { isSet } from '../lib/schemas';
import { settings } from '../lib/site';

const socials = [
  { key: 'instagram', label: 'Instagram' },
  { key: 'facebook', label: 'Facebook' },
  { key: 'tiktok', label: 'TikTok' },
  { key: 'googleBusinessProfile', label: 'Google Business Profile' },
].filter((s) => isSet(settings.socials[s.key as keyof typeof settings.socials]));
const tel = isSet(settings.phone) ? settings.phone.replace(/[^\d+]/g, '') : '';
const year = new Date().getFullYear();
---
<footer class="on-dark bg-olive-deep text-ivory">
  <div class="container-x grid gap-12 pt-16 pb-10 md:grid-cols-12 md:pt-24">
    <div class="md:col-span-5">
      <p class="display text-ivory h-md">Freshly prepared. <em class="text-olive-soft">Generously shared.</em></p>
      <p class="mt-5 max-w-sm text-olive-soft">Mediterranean lunchboxes, trays and event catering for {settings.serviceAreaLabel}.</p>

      <form
        name="newsletter"
        method="POST"
        action="/thanks/"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-astro-reload
        class="mt-8 max-w-md"
        aria-labelledby="newsletter-title"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <h2 id="newsletter-title" class="font-sans text-base font-bold text-ivory">Seasonal menus and office lunch ideas, about once a month</h2>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="input sm:flex-1" />
          <button type="submit" class="btn btn-primary">Sign up</button>
        </div>
        <label class="mt-3 flex items-start gap-3 text-sm text-olive-soft">
          <input type="checkbox" name="consent" value="yes" required class="mt-1 size-5 shrink-0 accent-[var(--brand-terracotta)]" />
          <span>Yes, email me menus and offers. I can unsubscribe at any time. See our <a href="/privacy/" class="underline underline-offset-2">privacy policy</a>.</span>
        </label>
      </form>
    </div>

    <div class="grid gap-10 sm:grid-cols-3 md:col-span-7">
      <div>
        <h2 class="font-sans text-sm font-bold text-olive-soft">Order</h2>
        <ul class="mt-4 space-y-1">
          {primaryNav.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
          {secondaryNav.map((l) => <li><a href={l.href} class="footer-link">{l.label}</a></li>)}
          <li><a href="/order/" class="footer-link">Build an Order</a></li>
        </ul>
      </div>
      <div>
        <h2 class="font-sans text-sm font-bold text-olive-soft">Service area</h2>
        <p class="mt-4">{settings.serviceAreaLabel}</p>
        <h2 class="mt-8 font-sans text-sm font-bold text-olive-soft">Contact</h2>
        <ul class="mt-4 space-y-1">
          {tel && <li><a href={`tel:${tel}`} class="footer-link">{settings.phone}</a></li>}
          {isSet(settings.email) && <li><a href={`mailto:${settings.email}`} class="footer-link break-all">{settings.email}</a></li>}
          <li><a href="/contact/" class="footer-link">Send us a message</a></li>
        </ul>
        {settings.hours.length > 0 && (
          <>
            <h2 class="mt-8 font-sans text-sm font-bold text-olive-soft">Hours</h2>
            <dl class="mt-4 space-y-1">
              {settings.hours.map((h) => <div class="flex gap-3"><dt class="font-semibold">{h.days}</dt><dd>{h.hours}</dd></div>)}
            </dl>
          </>
        )}
      </div>
      <div>
        {socials.length > 0 && (
          <>
            <h2 class="font-sans text-sm font-bold text-olive-soft">Follow</h2>
            <ul class="mt-4 mb-8 space-y-1">
              {socials.map((s) => <li><a href={settings.socials[s.key as keyof typeof settings.socials]} class="footer-link" rel="noopener">{s.label}</a></li>)}
            </ul>
          </>
        )}
        <h2 class="font-sans text-sm font-bold text-olive-soft">Policies</h2>
        <ul class="mt-4 space-y-1">
          <li><a href="/faq/" class="footer-link">FAQ & Policies</a></li>
          <li><a href="/privacy/" class="footer-link">Privacy</a></li>
          <li><a href="/terms/" class="footer-link">Terms</a></li>
          <li><button type="button" class="footer-link" data-consent-open>Cookie settings</button></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="container-x">
    <hr class="border-white/15" />
    <div class="flex flex-col gap-4 py-8 text-sm text-olive-soft md:flex-row md:items-start md:justify-between">
      <p class="max-w-2xl"><strong class="text-ivory">Dietary notice.</strong> {settings.dietaryDisclaimer}</p>
      <p class="shrink-0">© {year} {settings.businessName}</p>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex; align-items: center; min-height: 2.75rem;
    color: var(--brand-ivory); text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 0.6rem) / 0 1px no-repeat;
    transition: background-size 0.25s;
  }
  .footer-link:hover { background-size: 100% 1px; }
</style>
