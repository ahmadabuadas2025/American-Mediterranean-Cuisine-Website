---
import Base from '../layouts/Base.astro';
import FaqList from '../components/ui/FaqList.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { fillRules, getFaq, rules, settings } from '../lib/site';
import { isSet } from '../lib/schemas';
import { leadTimeLabel, money } from '../lib/order';

const faq = await getFaq();
const categories = [...new Set(faq.map((f) => f.data.category))];
const policies = [
  { label: 'Office delivery minimum', value: `${rules.minimums.officeMeals} meals or ${money(rules.minimums.officeSubtotal)} food subtotal, or a zone-specific minimum.` },
  { label: 'Standard lead time', value: `${leadTimeLabel(rules.leadTimeHours.office)} for lunchboxes, ${leadTimeLabel(rules.leadTimeHours.trays)} for trays, subject to kitchen capacity.` },
  { label: 'Events', value: 'Typically 7–14 days of notice; earlier for peak dates.' },
  { label: 'Event deposit', value: `${rules.eventDeposit.percent}% to hold the date; balance due ${rules.eventDeposit.balanceDueBusinessDays} business days before the event.` },
  { label: 'Rush orders', value: `${rules.rushFeePercent.min}–${rules.rushFeePercent.max}% fee when accepted inside our standard lead time.` },
  { label: 'Setup', value: `${money(rules.setupFee.min)}–${money(rules.setupFee.max)}+, depending on buffet size. Staff, chafers, linens and rentals are quoted.` },
  { label: 'Cancellations and changes', value: isSet(rules.cancellationPolicy) ? rules.cancellationPolicy : 'Being finalized. The schedule will be published here and in every quote before you pay.' },
  { label: 'Final guest count', value: isSet(rules.finalCountDeadline) ? rules.finalCountDeadline : 'Confirmed in your event quote.' },
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.data.question, acceptedAnswer: { '@type': 'Answer', text: fillRules(f.data.answer) } })),
};
---
<Base
  title="Catering FAQ & Policies | Lead Times, Delivery, Dietary"
  description="Answers about ordering Mediterranean catering in Tampa Bay: lead times, delivery, servings, dietary and allergen questions, payment, deposits and changes."
  jsonLd={[faqLd]}
>
  <section class="container-x pt-10 pb-12 md:pt-16">
    <p class="eyebrow">FAQ & policies</p>
    <h1 class="h-xl mt-5" data-reveal-words>Before you <em>order.</em></h1>
    <p class="lede mt-6">Lead times, delivery, servings, dietary questions and what happens after you send a request.</p>
    <nav aria-label="FAQ topics" class="mt-8">
      <ul class="flex flex-wrap gap-2">
        {categories.map((c) => <li><a href={`#${c.toLowerCase().replace(/\s+/g, '-')}`} class="inline-flex min-h-11 items-center rounded-full border border-olive-mid px-4 text-sm font-bold text-olive hover:bg-olive hover:text-ivory">{c}</a></li>)}
        <li><a href="#policies" class="inline-flex min-h-11 items-center rounded-full border border-olive-mid px-4 text-sm font-bold text-olive hover:bg-olive hover:text-ivory">Policies</a></li>
      </ul>
    </nav>
  </section>

  <div class="container-x grid gap-14 pb-20">
    {categories.map((c) => (
      <section id={c.toLowerCase().replace(/\s+/g, '-')} aria-labelledby={`h-${c}`} class="grid gap-6 lg:grid-cols-12">
        <h2 id={`h-${c}`} class="h-md lg:col-span-4">{c}</h2>
        <div class="lg:col-span-8"><FaqList items={faq.filter((f) => f.data.category === c)} /></div>
      </section>
    ))}

    <section id="policies" aria-labelledby="policies-title" class="grid gap-6 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 id="policies-title" class="h-md">Policies</h2>
        <p class="mt-3 text-sm text-muted">Proposed settings, pending final owner approval. Your quote always states the terms that apply to your order.</p>
      </div>
      <dl class="divide-y divide-sand border-y border-sand lg:col-span-8">
        {policies.map((p) => (
          <div class="grid gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
            <dt class="font-bold">{p.label}</dt>
            <dd class="text-muted">{p.value}</dd>
          </div>
        ))}
        <div class="grid gap-1 py-4 sm:grid-cols-[14rem_1fr] sm:gap-6">
          <dt class="font-bold">Dietary notice</dt>
          <dd class="text-muted">{settings.dietaryDisclaimer}</dd>
        </div>
      </dl>
    </section>
  </div>

  <CtaBand title="Still have a question? <em>Ask us.</em>" text="Send a message about allergies, delivery or an event, or go ahead and build your order." />
</Base>
