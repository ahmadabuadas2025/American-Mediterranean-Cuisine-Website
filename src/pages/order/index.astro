---
import Base from '../../layouts/Base.astro';
import OrderBuilder from '../../components/builder/OrderBuilder';
import { getCatalog, paymentsEnabled } from '../../lib/site';

const catalog = await getCatalog();
---
<Base
  title="Build a Catering Order | Lunchboxes, Trays & Events"
  description="Build a Mediterranean catering order for Tampa Bay in three steps: choose your need, create your food package, then add delivery and contact details."
>
  <section class="container-x pt-8 pb-24 md:pt-12">
    <p class="eyebrow">Order builder</p>
    <h1 class="h-lg mt-4">Build your order <em>in three steps.</em></h1>
    <p class="lede mt-4">Your selections save on this device as you go. Nothing is charged or booked until we confirm.</p>
    <div class="mt-10">
      <OrderBuilder client:idle catalog={catalog} paymentsEnabled={paymentsEnabled} />
      <noscript>
        <p class="card p-6">The order builder needs JavaScript. You can still <a class="underline" href="/contact/">send us a message</a> with what you need.</p>
      </noscript>
    </div>
  </section>
</Base>
