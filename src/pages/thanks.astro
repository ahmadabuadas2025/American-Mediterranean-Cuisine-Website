---
import Base from '../layouts/Base.astro';
---
<Base title="Message received" description="Thanks for getting in touch." noindex>
  <section class="container-x section max-w-3xl">
    <p class="eyebrow">Message received</p>
    <h1 class="h-xl mt-5">Thank you. <em>We’ll be in touch.</em></h1>
    <p class="lede mt-6">We have your message. This is not a confirmed order or booking; we reply with next steps, a quote or a confirmation.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/order/" class="btn btn-primary">Build an Order</a>
      <a href="/menu/" class="btn btn-ghost">Browse the menu</a>
    </div>
  </section>
</Base>
