---
import { getEntry, render } from 'astro:content';
import Base from './Base.astro';
import { isSet } from '../lib/schemas';

interface Props { slug: 'about' | 'privacy' | 'terms'; eyebrow: string; noindex?: boolean }
const { slug, eyebrow, noindex } = Astro.props;
const entry = await getEntry('pages', slug);
if (!entry) throw new Error(`Missing src/content/pages/${slug}.md`);
const { Content } = await render(entry);
const { title, description, draft_notice, updated } = entry.data;
---
<Base title={title} description={description} noindex={noindex}>
  <article class="container-x pt-10 pb-24 md:pt-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="h-xl mt-5 max-w-4xl">{title}</h1>
    {isSet(updated) && <p class="mt-4 text-sm text-muted">Last updated {updated}</p>}
    {draft_notice && (
      <p class="mt-6 max-w-2xl rounded-2xl border border-dashed border-terracotta bg-terracotta-soft/50 p-4 text-sm font-semibold text-terracotta-deep" data-owner-note>{draft_notice}</p>
    )}
    <div class="prose-amc mt-10 text-lg">
      <Content />
    </div>
    <slot />
  </article>
</Base>
