# Copy to .env for local development (`netlify dev` loads it). In production,
# set these in Netlify: Site configuration → Environment variables.
# Never commit real values.

# --- Orders dashboard (/admin/orders/) — 12+ characters
ADMIN_PASSWORD=

# --- Email (Resend: https://resend.com). Without these, orders are stored but no email is sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "American Mediterranean Cuisine <orders@yourdomain.com>"
EMAIL_FROM=
# Inbox that receives new order requests
BUSINESS_EMAIL=

# --- Payments (Stripe Checkout). Leave false until the owner approves prices, zones,
# lead times and a Stripe account. Only standard, approved, available orders check out.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint for https://<site>/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# --- Analytics (loaded only after visitor consent). Provider: plausible | ga4 | (empty = off)
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_GA4_ID=

# --- Optional: canonical site URL when not building on Netlify (Netlify sets URL automatically)
SITE_URL=
